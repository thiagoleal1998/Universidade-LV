NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# E-mail do admin — destino dos 2 avisos internos (novo cadastro pendente,
# novo chamado de feedback), disparados via RD Station (ver abaixo).
ADMIN_EMAIL=admin@seudominio.com.br

# Notion (sincronização automática de chamados de feedback) — opcional. Sem
# estas variáveis a sincronização é silenciosamente ignorada. Requer uma
# Internal Integration criada em notion.so/my-integrations, compartilhada com
# a base "Chamados" (Conectores da página no Notion).
NOTION_API_KEY=
NOTION_CHAMADOS_DATA_SOURCE_ID=cae77ba3-60af-4e67-ae31-e81cb7c2f362

# RD Station (disparo de e-mails de aluno + sincronização de leads) — opcional.
# Sem estas variáveis os disparos são silenciosamente ignorados. Requer um app
# OAuth2 criado em appstore.rdstation.com/pt-BR/publisher (produto "RD Station
# Marketing"). Depois de criado, é preciso autorizar uma vez visitando
# https://api.rd.services/auth/dialog?client_id=<RDSTATION_CLIENT_ID>&redirect_uri=<URL_DO_SITE>/api/rdstation/callback
# — isso grava o token inicial na tabela rdstation_tokens (migração 048); daí
# em diante o código renova sozinho via refresh_token.
RDSTATION_CLIENT_ID=
RDSTATION_CLIENT_SECRET=

# Cloudflare Turnstile, modo invisible (login, cadastro, esqueci senha,
# formulário de lead da landing) — opcional. Sem estas variáveis a verificação
# é silenciosamente pulada (não bloqueia). Criar em
# dash.cloudflare.com/?to=/:account/turnstile, widget mode "Invisible",
# domínio universidadelv.com.br (+ localhost pra dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web Push (notificação nativa do navegador/SO, tipo Chrome) — opcional. Sem
# estas variáveis, a inscrição falha silenciosamente (só a notificação do
# sino continua funcionando). Gerar com `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Deploy na VPS — usado por `npm run deploy` (scripts/deploy-vps.cjs).
# Requer o pacote ssh2 instalado globalmente: npm install -g ssh2
VPS_HOST=
VPS_PORT=22
VPS_USER=root
VPS_PASSWORD=
VPS_APP_DIR=/root/Universidade-LV
VPS_PM2_NAME=universidade-lv
