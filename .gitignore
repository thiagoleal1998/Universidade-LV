# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# log local do health-check (scripts/health-check.mjs) — cada máquina/VPS
# acumula o próprio
/logs/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — settings.json e agents/skills são versionados (valem pro time);
# settings.local.json é pessoal e acumula permissões one-off de cada máquina.
.claude/settings.local.json

# scripts e capturas descartáveis de verificação (criados durante testes E2E).
# Os scripts permanentes ficam em scripts/, que É versionado.
/verify-*.mjs
/debug-*.mjs
/check-*.mjs
/*-tmp.mjs
/*-test.png
/*-shot.png
